# ===== MiniFlow 配置示例 =====
# 复制本文件为 .env 后按需修改。.env 已被 .gitignore 忽略，不会进仓库。

# ---- 服务 ----
PORT=3000
# 默认只监听本机。改成 0.0.0.0 会把「可执行任意代码」的服务暴露到局域网，请谨慎
HOST=127.0.0.1
# SQLite 数据库文件位置
# MINIFLOW_DB=./data/miniflow.db

# ---- 模型服务（OpenAI 兼容协议，换 base url 即可换厂商）----
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OWN_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 其他常用厂商（把上面 OPENAI_BASE_URL 换掉即可）：
#   DeepSeek      https://api.deepseek.com/v1         模型 deepseek-chat
#   月之暗面 Kimi https://api.moonshot.cn/v1          模型 moonshot-v1-8k
#   阿里通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
#   本地 Ollama   http://localhost:11434/v1           模型 qwen2.5:7b（密钥随便填一个非空值）

# ---- 超时（防止服务被拖死）----
# code 节点执行超时（毫秒）。同步死循环与永不 resolve 的 Promise 都会被中断。
# 默认 5000。设为 0 或负数不会关闭超时，仍按默认值处理
# MINIFLOW_CODE_TIMEOUT_MS=5000
# 模型请求超时（毫秒）。模型服务假死时，没有超时会让整条工作流永久悬挂
# 默认 120000
# MINIFLOW_LLM_TIMEOUT_MS=120000

# ---- 安全 ----
# 设为 1 时禁止 code 节点与 {{ }} 表达式求值。对外提供服务时建议开启
# MINIFLOW_SAFE_MODE=1
# 允许表达式通过 $env.XXX 读取的环境变量名（逗号分隔）。默认不暴露任何变量，
# 以免 API Key 被写进提示词或执行日志
# MINIFLOW_EXPOSED_ENV=TZ
# 需要跨域调用 API 时设为 1（默认关闭）
# MINIFLOW_CORS=1
# 上面开启后，建议同时配置来源白名单（逗号分隔），命中才回显该来源；
# 不配置则回退为 "*"（宽松模式，仅建议本地开发使用）
# MINIFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
